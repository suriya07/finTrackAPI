# Copy this file to /etc/fintrack-api.env on the server and fill in the real values.
# chown root:fintrack /etc/fintrack-api.env && chmod 640 /etc/fintrack-api.env

SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080

# ===== RDS Postgres =====
# Get the endpoint from the RDS console (e.g. fintrack-db.xxxxxx.ap-south-1.rds.amazonaws.com)
DATABASE_URL=jdbc:postgresql://CHANGE_ME-endpoint:5432/fintrack
PGUSER=fintrack_app
PGPASSWORD=CHANGE_ME

# ===== JWT =====
# Generate with: openssl rand -base64 64 | tr -d '\n'
JWT_SECRET=CHANGE_ME_long_random_string
JWT_EXPIRATION=86400000

# ===== Frontend URL (used in password reset emails) =====
FRONTEND_URL=https://api.example.com

# ===== Mail (SMTP) =====
# Gmail SMTP example. If using Gmail, create an App Password.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=CHANGE_ME@gmail.com
MAIL_PASSWORD=CHANGE_ME_app_password
MAIL_FROM=noreply@example.com
